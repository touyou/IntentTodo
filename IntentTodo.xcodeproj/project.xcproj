    {
      "name": "IntentTodo",
      "id": "46AFBC382F2BA68C00444306",
      "product": "Products/Intento.app",
      "product-type": "application",
      "dependencies": [
        "IntentTodoWidgetExtension",
        "IntentTodoLiveActivityExtension",
        "IntentTodoWatchApp",
      ],
      "build-phases": [
