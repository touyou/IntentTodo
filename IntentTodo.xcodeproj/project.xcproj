        }, {
          "path": "/System/Library/Frameworks/SwiftUI.framework",
          "target-membership": [
            "IntentTodoWidgetExtension/frameworks",
            "IntentTodoLiveActivityExtension/frameworks",
          ],
        },
      ],
    }, {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Intento.app", "id": "46AFBC392F2BA68C00444306", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/IntentTodoWidgetExtension.appex", "id": "46AFBEBE2F2CFEA400444306", "type": "wrapper.app-extension", "index": false, "target-membership": [ { "build-phase": "IntentTodo/copy/Embed Foundation Extensions", "header-preservation": "remove-on-copy" } ] },
